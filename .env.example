# ─────────────────────────────────────────────
#  Divya Portfolio — Contact API Environment
#  Copy this to .env and fill in real values.
#  NEVER commit .env to GitHub.
# ─────────────────────────────────────────────

PORT=3000

# Get from resend.com → API Keys → Create API Key
RESEND_API_KEY=

# Email address that receives contact form submissions
RECEIVER_EMAIL=gmail.com

# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=.vercel.app
