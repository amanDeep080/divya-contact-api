# ─────────────────────────────────────────────
#  Divya Portfolio — Contact API Environment
#  Copy this file to .env and fill in values.
#  NEVER commit .env to GitHub.
# ─────────────────────────────────────────────

# Port (Render sets this automatically — leave as 3000 for local dev)
PORT=3000

# Your Gmail address (the one that sends + receives contact emails)
GMAIL_USER=amandeepkumar0806@gmail.com

# 16-character App Password from Google Account → Security → App Passwords
# Guide: https://support.google.com/accounts/answer/185833
# Example format (not a real password): abcd efgh ijkl mnop
GMAIL_APP_PASS=vlzz ckpg bics ziez

# Where the notification email is delivered (can be same as GMAIL_USER)
RECEIVER_EMAIL=amandeepkumar0806@gmail.com

# Your Vercel frontend URL — MUST match exactly (no trailing slash)
# Example: https://divya-portfolio.vercel.app
FRONTEND_URL=https://divya-portfolio-frontend.vercel.app
